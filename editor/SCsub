#!/usr/bin/env python

Import("env")
Import("env_modules")

env_hyperbolic3d = env_modules.Clone()

env_hyperbolic3d.add_source_files(env.modules_sources, "*.cpp")
env_hyperbolic3d.add_source_files(env.modules_sources, "icons/*.cpp")

# The rest of this file handles generating the H3D icons header file.
import importlib.util
import os
import sys

header_builders_path = os.path.abspath(
    os.path.join("../addons/hyperbolic3d/src/header_builders.py")
)
spec = importlib.util.spec_from_file_location("header_builders", header_builders_path)
header_builders = importlib.util.module_from_spec(spec)
sys.modules["header_builders"] = header_builders
spec.loader.exec_module(header_builders)

env["BUILDERS"]["MakeSVGIconsBuilder"] = Builder(
    action=env.Run(header_builders.make_svg_icons_action),
    suffix=".h",
    src_suffix=".svg",
)

target_file_path = "icons/editor_h3d_icons.gen.h"
icon_sources = Glob("../addons/hyperbolic3d/icons/NodeH3D.svg")
env.Alias("editor_h3d_icons", [env.MakeSVGIconsBuilder(target_file_path, icon_sources)])
